# MongoDB Connection
MONGODB_URI=mongodb://localhost:27017/knowledge-hub

# Server
PORT=3001
NODE_ENV=development

# API Key for write operations (optional but recommended)
# AI agents must include this in the X-API-Key header for write operations
API_WRITE_KEY=your-secret-api-key-here

# CORS - comma-separated allowed origins (leave empty to allow all in dev)
CORS_ORIGINS=http://localhost:5173

# Whether to allow public read access to the API (true/false)
PUBLIC_READ_ACCESS=true

